---
import MainLayout from '../layouts/main-layout.astro';
import { RapidFireMultiplicationComponent } from '../components/rapid-fire-multiplication/rapid-fire-multiplication.component';

const user = Astro.cookies.get('user');
if (!user) {
	console.log('Redirecting to register page');
	return Astro.redirect('/register');
}
---

<MainLayout>
  <h2 class="text-3xl font-extrabold text-indigo-700 dark:text-indigo-300 mb-4">Rapid Fire Multiplication</h2>
  <p class="text-lg md:text-xl text-gray-700 dark:text-gray-200 mb-8">
    Get ready for Rapid Fire Multiplication! You have 1 minute to solve as many multiplication problems as you can. Each question will have two numbers (up to 2 digits each). Type your answer and hit enter—if you get it right, zoom to the next one! Try to beat your high score and become the Multiplication Ace! Can you answer more than your friends? Let's see how fast your brain can multiply!
  </p>
  <div class="flex flex-col items-center justify-center min-h-[60vh]">
    <RapidFireMultiplicationComponent client:load />
  </div>
</MainLayout>